{
  "name": "codesane",
  "version": "0.1.0",
  "description": "Don't ship a quiet weakening — catch coding agents that empty a catch, add as any, drop an auth check, or leave unfinished stubs in production code.",
  "keywords": [
    "cli",
    "git",
    "diff",
    "mcp",
    "ci",
    "coding-agents",
    "security",
    "verification"
  ],
  "author": "MaxWang007",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaxWang007/codesane.git"
  },
  "homepage": "https://github.com/MaxWang007/codesane",
  "bugs": {
    "url": "https://github.com/MaxWang007/codesane/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codesane": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
